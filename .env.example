MFETOS_DATA_DIR=./data
# No credentials required. deterministic | ollama
MFETOS_LLM_PROVIDER=deterministic
MFETOS_OLLAMA_URL=http://localhost:11434
MFETOS_OLLAMA_MODEL=
MFETOS_HTTP_TIMEOUT=30
MFETOS_MODEL_TIMEOUT=120
MFETOS_MAX_RETRIEVAL_ROUNDS=2
MFETOS_WORKER_CONCURRENCY=2
# Optional providers are disabled until explicitly configured.
MFETOS_UPSTOX_TOKEN=
MFETOS_UPSTOX_LICENSE_ACK=false
# Retain licensed vendor responses only if your agreement permits retention.
MFETOS_ALLOW_LICENSED_RETENTION=false

# Local parser: pdfplumber | docling (install .[docling] and run parsers prepare).
MFETOS_PDF_PARSER=pdfplumber
# Empty paths derive from MFETOS_DATA_DIR.
MFETOS_DOCLING_ARTIFACTS_PATH=
MFETOS_DOCLING_TIMEOUT=600

# Structured local logs. Stderr plus rotating per-process JSONL files.
MFETOS_LOG_LEVEL=INFO
MFETOS_LOG_DIR=

# Optional LangSmith: ONLY metadata is exported, never documents or model messages.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=mfetos
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
