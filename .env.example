MFETOS_DATA_DIR=./data
# No credentials required. deterministic | ollama
MFETOS_LLM_PROVIDER=deterministic
MFETOS_OLLAMA_URL=http://localhost:11434
MFETOS_OLLAMA_MODEL=
MFETOS_HTTP_TIMEOUT=30
MFETOS_MODEL_TIMEOUT=120
MFETOS_MAX_RETRIEVAL_ROUNDS=2
MFETOS_WORKER_CONCURRENCY=2
# Optional providers are disabled until explicitly configured.
MFETOS_UPSTOX_TOKEN=
MFETOS_UPSTOX_LICENSE_ACK=false
MFETOS_TRENDLYNE_URL=
MFETOS_TRENDLYNE_TOKEN=
MFETOS_TRENDLYNE_LICENSE_ACK=false
# Retain licensed vendor responses only if your agreement permits retention.
MFETOS_ALLOW_LICENSED_RETENTION=false
